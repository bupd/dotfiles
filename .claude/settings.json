{
  "model": "claude-fable-5[1m]",
  "env": {
    "SHELL": "/usr/bin/zsh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "voiceEnabled": true,
  "hooks": {"SessionStart":[{"matcher":"*","hooks":[{"type":"command","command":"bash '/home/bupd/.claude/hooks/herdr-agent-state.sh' session","timeout":10}]}]}
}
