[Unit]
Description=Donna: Discord voice/text inbox (discordwatch)
Documentation=file:///var/home/bupd/obsidian/donna/bin/discordwatch
After=network-online.target

[Service]
ExecStart=/var/home/bupd/obsidian/donna/bin/discordwatch daemon
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
