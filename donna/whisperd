#!/home/bupd/.local/share/donna-voice/fw/bin/python
"""whisperd - persistent whisper server so transcription is instant.

usage: whisperd serve              (daemon; donna-infra-whisperd.service)
       whisperd transcribe FILE [LANG]   client: print transcript
       whisperd ping                client: exit 0 if the daemon is up

`hyprwhspr transcribe` reloads the 1.5GB large-v3-turbo model on every
call (~17s). This daemon (pywhispercpp, CUDA) loads it once and answers
over a unix socket in under a second. Language auto-detects per request
(English/Hindi/Tamil/anything whisper knows) unless LANG is given.

Protocol: one JSON line per request {"wav": path, "lang": "auto"} ->
one JSON line reply {"text": ...} or {"error": ...}.
Clients should fall back to `hyprwhspr transcribe` when ping fails.
"""
import json
import os
import socket
import sys
from pathlib import Path

MODEL = Path.home() / ".local/share/hyprwhspr/models/ggml-large-v3-turbo.bin"
RUNDIR = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "donna"
SOCK = RUNDIR / "whisperd.sock"


def serve():
    # faster-whisper ships CUDA as pip wheels (cublas/cudnn) - no system
    # toolkit needed, which matters on this bootc host where pacman cannot
    # install the cuda package (/opt conflict). GPU ~1s/utterance vs ~22s
    # CPU for the same turbo model.
    #
    # The dynamic loader cannot see the wheel lib dirs on its own; set
    # LD_LIBRARY_PATH and re-exec once so ctranslate2 finds libcublas/cudnn.
    lib_dirs = []
    for sp in __import__("site").getsitepackages():
        for sub in ("nvidia/cublas/lib", "nvidia/cudnn/lib"):
            d = Path(sp) / sub
            if d.is_dir():
                lib_dirs.append(str(d))
    current = os.environ.get("LD_LIBRARY_PATH", "")
    if lib_dirs and not all(d in current.split(":") for d in lib_dirs):
        os.environ["LD_LIBRARY_PATH"] = ":".join(lib_dirs + ([current] if current else []))
        os.execv(sys.executable, [sys.executable, __file__, "serve"])

    from faster_whisper import WhisperModel
    print("whisperd: loading large-v3-turbo...", flush=True)
    try:
        model = WhisperModel("large-v3-turbo", device="cuda", compute_type="float16")
        dev = "cuda"
    except Exception as e:
        print(f"whisperd: cuda unavailable ({str(e)[:120]}) - cpu int8 fallback", flush=True)
        model = WhisperModel("large-v3-turbo", device="cpu", compute_type="int8")
        dev = "cpu"
    print(f"whisperd: model loaded on {dev}, serving", flush=True)
    _serve_loop(model)


def _serve_loop(model):
    RUNDIR.mkdir(parents=True, exist_ok=True)
    SOCK.unlink(missing_ok=True)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(str(SOCK))
    os.chmod(SOCK, 0o600)
    srv.listen(4)
    while True:
        conn, _ = srv.accept()
        try:
            data = b""
            while not data.endswith(b"\n"):
                chunk = conn.recv(65536)
                if not chunk:
                    break
                data += chunk
            req = json.loads(data)
            lang = req.get("lang") or None
            if lang == "auto":
                lang = None   # faster-whisper spells auto-detect as None
            # task=translate makes every language land as English - Hindi,
            # Tamil, whatever - which is what the agents read best. English
            # in, English out; it is a no-op for English speech.
            segs, _info = model.transcribe(req["wav"], language=lang, task="translate")
            text = " ".join(s.text.strip() for s in segs).strip()
            conn.sendall((json.dumps({"text": text}) + "\n").encode())
        except Exception as e:
            try:
                conn.sendall((json.dumps({"error": str(e)}) + "\n").encode())
            except OSError:
                pass
        finally:
            conn.close()


def ask(payload, timeout=120):
    c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    c.settimeout(timeout)
    c.connect(str(SOCK))
    c.sendall((json.dumps(payload) + "\n").encode())
    data = b""
    while not data.endswith(b"\n"):
        chunk = c.recv(65536)
        if not chunk:
            break
        data += chunk
    c.close()
    return json.loads(data)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "serve":
        serve()
        return 0
    if argv[0] == "ping":
        try:
            ask({"wav": "", "lang": "auto"}, timeout=5)
            return 0
        except OSError:
            return 1
    if argv[0] == "transcribe":
        if len(argv) < 2:
            print("whisperd: transcribe needs a file", file=sys.stderr)
            return 2
        wav = str(Path(argv[1]).resolve())
        lang = argv[2] if len(argv) > 2 else "auto"
        try:
            r = ask({"wav": wav, "lang": lang})
        except OSError as e:
            print(f"whisperd: daemon unreachable: {e}", file=sys.stderr)
            return 3
        if "error" in r:
            print(f"whisperd: {r['error']}", file=sys.stderr)
            return 1
        print(r["text"])
        return 0
    print(f"whisperd: unknown command {argv[0]!r}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
