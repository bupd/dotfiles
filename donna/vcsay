#!/usr/bin/env bash
# vcsay - say something out loud in the agents-vc voice channel
#
# usage: vcsay <text...>     (or pipe text on stdin)
#
# Drops the text into the discordvoice spool; the voice daemon synthesizes
# it (kokoro) and plays it in the channel. Queued in order, one at a time.
# If Donna is not connected to the channel, the text waits in the spool.
set -euo pipefail

SPOOL="${XDG_STATE_HOME:-$HOME/.local/state}/donna/vc-say"

EXT="txt"
case "${1:-}" in
  -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  --hi) EXT="hi.txt"; shift ;;   # speak this line in Hindi (Devanagari)
esac

text="${*:-}"
if [[ -z "$text" ]]; then
  text="$(cat)"
fi
[[ -n "${text// /}" ]] || { echo "vcsay: nothing to say" >&2; exit 2; }

mkdir -p "$SPOOL"
f="$SPOOL/$(date +%s%N).$EXT"
printf '%s\n' "$text" > "$f"
echo "queued: $f"
